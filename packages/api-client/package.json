{
  "name": "@coral/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Coral API, generated from its OpenAPI schema.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "whatwg-fetch": "3.6.20"
  }
}
