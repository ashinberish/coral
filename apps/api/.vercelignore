# Only list files that git does NOT track. Vercel's Python builder walks the tracked file
# list, so ignoring a tracked file (Dockerfile, tests/, ...) makes the remote build fail
# with "ENOENT ... readlink". Untracked local artefacts are safe to exclude:
.venv
.env
.pytest_cache
.mypy_cache
.ruff_cache
**/__pycache__
