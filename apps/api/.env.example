# Copy to .env for local development. All variables use the CORAL_ prefix;
# nested groups use "__" (e.g. CORAL_DATABASE__HOST).
CORAL_ENV=local
CORAL_LOG_LEVEL=INFO
CORAL_LOG_FORMAT=console
CORAL_CORS_ORIGINS=http://localhost:8081

CORAL_DATABASE__HOST=localhost
CORAL_DATABASE__PORT=5432
CORAL_DATABASE__USER=coral
CORAL_DATABASE__PASSWORD=coral
CORAL_DATABASE__NAME=coral

CORAL_TELEMETRY__ENABLED=false
CORAL_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
CORAL_TELEMETRY__SAMPLE_RATIO=1.0
