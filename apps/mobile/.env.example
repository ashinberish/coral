# Copy to .env.local (Expo loads it automatically). EXPO_PUBLIC_* values are bundled into
# the app — never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Sign-In (Google Cloud Console → Credentials → OAuth client IDs)
# Web client ID: becomes the ID token audience the API verifies (CORAL_AUTH__GOOGLE_AUDIENCES).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID: also generates the iOS URL scheme in app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
